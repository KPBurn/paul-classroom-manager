# Only VITE_-prefixed variables reach the browser bundle.
# Never put database credentials or JWT secrets in this file.
VITE_API_URL=http://localhost:5050/api

# Optional local development-only login prefill; values are read only by Vite's dev server.
# Do not use production credentials. Add these to .env.development.local, not this shared example.
# VITE_DEV_LOGIN_EMAIL=
# VITE_DEV_LOGIN_PASSWORD=
