PORT=5050
NODE_ENV=test

# In-memory MongoDB URI for testing (no real database needed)
MONGODB_URI=mongodb://127.0.0.1:27017/ctms-test

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=2f8c1d5b9a47e603c1f2b8d74a95e0c36b1f7d82ae4590c36d1b5f70a2e84c9d

JWT_EXPIRES_IN=1d

# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:5173

# Set to 1 when running behind a reverse proxy (Render, Railway, Nginx)
TRUST_PROXY=0
