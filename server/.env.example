PORT=5050
NODE_ENV=development

# MongoDB Atlas connection string (Atlas → Database → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ctms?retryWrites=true&w=majority

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:5173

# Set to 1 when running behind a reverse proxy (Render, Railway, Nginx)
TRUST_PROXY=0

# Used only by `npm run seed` to create the first accounts
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_TEACHER_EMAIL=teacher@example.com
SEED_TEACHER_PASSWORD=
