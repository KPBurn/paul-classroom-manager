PORT=5050
NODE_ENV=development

# MongoDB Atlas connection string (Atlas → Database → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ctms?retryWrites=true&w=majority

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:5173

# Set to 1 when running behind a reverse proxy (Render, Railway, Nginx)
TRUST_PROXY=0

# Where the web app is opened, for links in emails. Defaults to the first CLIENT_URL.
# Include the path when the app is served from one, e.g. https://<user>.github.io/<repo>
APP_URL=http://localhost:5173

# Email (enrollment confirmations and decisions, password reset) is sent through Resend (resend.com).
# Leave the key empty to send nothing: the server logs each email it skipped.
RESEND_API_KEY=
# The sender. Resend's test address only delivers to your own Resend account email;
# verify a domain in Resend to email applicants, then use e.g. School Name <enrollment@school.edu>
MAIL_FROM=Classroom Manager <onboarding@resend.dev>

# Days to keep enrollment applications that were not approved or were withdrawn.
# Leave empty to keep them until an administrator removes them.
ENROLLMENT_RETENTION_DAYS=

# Used only by `npm run seed` to create the first accounts
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_TEACHER_EMAIL=teacher@example.com
SEED_TEACHER_PASSWORD=
SEED_STUDENT_EMAIL=paul@example.com
SEED_STUDENT_PASSWORD=
